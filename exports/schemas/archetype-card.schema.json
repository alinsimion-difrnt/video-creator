{
  "$defs": {
    "Annotator": {
      "enum": [
        "code",
        "claude-code",
        "human"
      ],
      "title": "Annotator",
      "type": "string"
    },
    "ArchetypeStats": {
      "additionalProperties": false,
      "properties": {
        "beat_mix": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Beat Mix",
          "type": "object"
        },
        "duration_s": {
          "$ref": "#/$defs/Stat"
        },
        "events_per_shot": {
          "$ref": "#/$defs/Stat"
        },
        "examples": {
          "items": {
            "$ref": "#/$defs/SceneExample"
          },
          "title": "Examples",
          "type": "array"
        },
        "first_motion_s": {
          "$ref": "#/$defs/Stat"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "pattern_mix": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Pattern Mix",
          "type": "object"
        },
        "sfx_label_mix": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Sfx Label Mix",
          "type": "object"
        },
        "sfx_offset_s_by_label": {
          "additionalProperties": {
            "$ref": "#/$defs/Stat"
          },
          "title": "Sfx Offset S By Label",
          "type": "object"
        },
        "shot_type_mix": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Shot Type Mix",
          "type": "object"
        },
        "shots": {
          "minimum": 0,
          "title": "Shots",
          "type": "integer"
        },
        "transition_mix": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Transition Mix",
          "type": "object"
        },
        "videos": {
          "minimum": 0,
          "title": "Videos",
          "type": "integer"
        },
        "weight": {
          "minimum": 0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "id",
        "shots",
        "videos",
        "weight",
        "duration_s",
        "events_per_shot",
        "first_motion_s",
        "pattern_mix",
        "transition_mix",
        "shot_type_mix",
        "beat_mix",
        "sfx_label_mix",
        "sfx_offset_s_by_label",
        "examples"
      ],
      "title": "ArchetypeStats",
      "type": "object"
    },
    "Build": {
      "additionalProperties": false,
      "properties": {
        "gsap": {
          "minLength": 1,
          "title": "Gsap",
          "type": "string"
        },
        "remotion": {
          "minLength": 1,
          "title": "Remotion",
          "type": "string"
        }
      },
      "required": [
        "gsap",
        "remotion"
      ],
      "title": "Build",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Carried by every output JSON (BUILD_PLAN section 2.7).",
      "properties": {
        "annotator": {
          "$ref": "#/$defs/Annotator"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "input_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "skill": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9-]+@[0-9a-f]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skill"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "tool_version": {
          "title": "Tool Version",
          "type": "string"
        }
      },
      "required": [
        "tool_version",
        "stage",
        "annotator",
        "input_hash",
        "created_at"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "SceneExample": {
      "additionalProperties": false,
      "properties": {
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Score"
        },
        "shot": {
          "title": "Shot",
          "type": "string"
        },
        "video": {
          "title": "Video",
          "type": "string"
        }
      },
      "required": [
        "video",
        "shot",
        "score"
      ],
      "title": "SceneExample",
      "type": "object"
    },
    "Slot": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "what": {
          "minLength": 3,
          "title": "What",
          "type": "string"
        }
      },
      "required": [
        "name",
        "what"
      ],
      "title": "Slot",
      "type": "object"
    },
    "Stat": {
      "additionalProperties": false,
      "properties": {
        "ci": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ci"
        },
        "median": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Median"
        },
        "n": {
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "p25": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "P25"
        },
        "p75": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "P75"
        },
        "videos": {
          "minimum": 0,
          "title": "Videos",
          "type": "integer"
        },
        "weight": {
          "minimum": 0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "n",
        "videos",
        "weight",
        "median",
        "p25",
        "p75",
        "ci"
      ],
      "title": "Stat",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "`corpus/archetypes/<aid>.json`: one scene archetype, a template a builder fills with content.",
  "properties": {
    "build": {
      "$ref": "#/$defs/Build"
    },
    "caveats": {
      "items": {
        "type": "string"
      },
      "maxItems": 3,
      "title": "Caveats",
      "type": "array"
    },
    "examples": {
      "items": {
        "$ref": "#/$defs/SceneExample"
      },
      "title": "Examples",
      "type": "array"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "name": {
      "maxLength": 60,
      "minLength": 2,
      "title": "Name",
      "type": "string"
    },
    "numbers": {
      "$ref": "#/$defs/ArchetypeStats"
    },
    "patterns": {
      "items": {
        "type": "string"
      },
      "title": "Patterns",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "slots": {
      "items": {
        "$ref": "#/$defs/Slot"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Slots",
      "type": "array"
    },
    "sound": {
      "title": "Sound",
      "type": "string"
    },
    "steps": {
      "items": {
        "type": "string"
      },
      "maxItems": 8,
      "minItems": 2,
      "title": "Steps",
      "type": "array"
    },
    "summary": {
      "maxLength": 300,
      "minLength": 10,
      "title": "Summary",
      "type": "string"
    },
    "when_to_use": {
      "items": {
        "type": "string"
      },
      "maxItems": 4,
      "minItems": 1,
      "title": "When To Use",
      "type": "array"
    }
  },
  "required": [
    "provenance",
    "id",
    "name",
    "summary",
    "when_to_use",
    "slots",
    "steps",
    "patterns",
    "build",
    "sound",
    "numbers",
    "examples"
  ],
  "title": "ArchetypeCard",
  "type": "object"
}
