{
  "$defs": {
    "Annotator": {
      "enum": [
        "code",
        "claude-code",
        "human"
      ],
      "title": "Annotator",
      "type": "string"
    },
    "BuildHint": {
      "additionalProperties": false,
      "properties": {
        "gsap": {
          "minLength": 1,
          "title": "Gsap",
          "type": "string"
        },
        "remotion": {
          "minLength": 1,
          "title": "Remotion",
          "type": "string"
        }
      },
      "required": [
        "gsap",
        "remotion"
      ],
      "title": "BuildHint",
      "type": "object"
    },
    "Element": {
      "additionalProperties": false,
      "properties": {
        "box": {
          "anyOf": [
            {
              "pattern": "^b\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Box"
        },
        "change_other": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Change Other"
        },
        "change_types": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Change Types",
          "type": "array"
        },
        "estimates": {
          "anyOf": [
            {
              "$ref": "#/$defs/Estimates"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "is_text": {
          "title": "Is Text",
          "type": "boolean"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "manual_box": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manual Box"
        },
        "manual_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Manual Reason"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "role_other": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role Other"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "text_unit": {
          "anyOf": [
            {
              "enum": [
                "whole",
                "line",
                "word",
                "char",
                "unknown"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text Unit"
        }
      },
      "required": [
        "label",
        "role",
        "change_types",
        "is_text"
      ],
      "title": "Element",
      "type": "object"
    },
    "Estimates": {
      "additionalProperties": false,
      "description": "Fallback guesses; S7 measures replace them. Always model estimates.",
      "properties": {
        "duration_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        },
        "easing_class": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Easing Class"
        },
        "source": {
          "const": "model_estimate",
          "default": "model_estimate",
          "title": "Source",
          "type": "string"
        }
      },
      "title": "Estimates",
      "type": "object"
    },
    "Pattern": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "proposed_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proposed Name"
        },
        "why_premium": {
          "minLength": 1,
          "title": "Why Premium",
          "type": "string"
        }
      },
      "required": [
        "id",
        "description",
        "why_premium"
      ],
      "title": "Pattern",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Carried by every output JSON (BUILD_PLAN section 2.7).",
      "properties": {
        "annotator": {
          "$ref": "#/$defs/Annotator"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "input_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "skill": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9-]+@[0-9a-f]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skill"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "tool_version": {
          "title": "Tool Version",
          "type": "string"
        }
      },
      "required": [
        "tool_version",
        "stage",
        "annotator",
        "input_hash",
        "created_at"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "SfxReview": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^x\\d{3,}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "verdict": {
          "enum": [
            "confirm",
            "override",
            "unsure"
          ],
          "title": "Verdict",
          "type": "string"
        }
      },
      "required": [
        "id",
        "verdict",
        "label"
      ],
      "title": "SfxReview",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "build_hint": {
      "$ref": "#/$defs/BuildHint"
    },
    "confidence": {
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "elements": {
      "items": {
        "$ref": "#/$defs/Element"
      },
      "maxItems": 12,
      "title": "Elements",
      "type": "array"
    },
    "event": {
      "pattern": "^e\\d{3,}$",
      "title": "Event",
      "type": "string"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    },
    "pattern": {
      "$ref": "#/$defs/Pattern"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "sfx_review": {
      "items": {
        "$ref": "#/$defs/SfxReview"
      },
      "title": "Sfx Review",
      "type": "array"
    },
    "task": {
      "pattern": "^a2-e\\d{3,}$",
      "title": "Task",
      "type": "string"
    },
    "video": {
      "title": "Video",
      "type": "string"
    }
  },
  "required": [
    "provenance",
    "video",
    "event",
    "task",
    "elements",
    "sfx_review",
    "pattern",
    "build_hint",
    "confidence"
  ],
  "title": "A2File",
  "type": "object"
}
