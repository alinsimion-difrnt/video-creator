{
  "$defs": {
    "Annotator": {
      "enum": [
        "code",
        "claude-code",
        "human"
      ],
      "title": "Annotator",
      "type": "string"
    },
    "CameraFact": {
      "additionalProperties": false,
      "properties": {
        "move": {
          "title": "Move",
          "type": "string"
        },
        "pan_x": {
          "title": "Pan X",
          "type": "number"
        },
        "pan_y": {
          "title": "Pan Y",
          "type": "number"
        },
        "scale": {
          "title": "Scale",
          "type": "number"
        }
      },
      "required": [
        "move",
        "pan_x",
        "pan_y",
        "scale"
      ],
      "title": "CameraFact",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Carried by every output JSON (BUILD_PLAN section 2.7).",
      "properties": {
        "annotator": {
          "$ref": "#/$defs/Annotator"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "input_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "skill": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9-]+@[0-9a-f]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skill"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "tool_version": {
          "title": "Tool Version",
          "type": "string"
        }
      },
      "required": [
        "tool_version",
        "stage",
        "annotator",
        "input_hash",
        "created_at"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "SfxFact": {
      "additionalProperties": false,
      "properties": {
        "clap_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clap Label"
        },
        "clap_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clap Score"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "offset_ms": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Offset Ms"
        },
        "sync_s": {
          "title": "Sync S",
          "type": "number"
        }
      },
      "required": [
        "id",
        "sync_s",
        "label"
      ],
      "title": "SfxFact",
      "type": "object"
    },
    "WordAnchor": {
      "additionalProperties": false,
      "properties": {
        "end_s": {
          "minimum": 0,
          "title": "End S",
          "type": "number"
        },
        "i": {
          "minimum": 0,
          "title": "I",
          "type": "integer"
        },
        "start_s": {
          "minimum": 0,
          "title": "Start S",
          "type": "number"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "i",
        "text",
        "start_s",
        "end_s"
      ],
      "title": "WordAnchor",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "`events/<eid>/facts.json`: measured context for one event (A2).",
  "properties": {
    "burst_frames": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "type": "integer"
        },
        {
          "type": "integer"
        }
      ],
      "title": "Burst Frames",
      "type": "array"
    },
    "camera": {
      "$ref": "#/$defs/CameraFact"
    },
    "end_s": {
      "title": "End S",
      "type": "number"
    },
    "energy": {
      "items": {
        "type": "number"
      },
      "title": "Energy",
      "type": "array"
    },
    "event": {
      "title": "Event",
      "type": "string"
    },
    "filmstrip_frames": {
      "items": {
        "type": "integer"
      },
      "title": "Filmstrip Frames",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "sfx": {
      "items": {
        "$ref": "#/$defs/SfxFact"
      },
      "title": "Sfx",
      "type": "array"
    },
    "shot": {
      "title": "Shot",
      "type": "string"
    },
    "siblings": {
      "items": {
        "type": "string"
      },
      "title": "Siblings",
      "type": "array"
    },
    "start_s": {
      "title": "Start S",
      "type": "number"
    },
    "video": {
      "title": "Video",
      "type": "string"
    },
    "words": {
      "items": {
        "$ref": "#/$defs/WordAnchor"
      },
      "title": "Words",
      "type": "array"
    }
  },
  "required": [
    "provenance",
    "video",
    "event",
    "shot",
    "start_s",
    "end_s",
    "burst_frames",
    "filmstrip_frames",
    "energy",
    "camera",
    "sfx",
    "words"
  ],
  "title": "EventFacts",
  "type": "object"
}
