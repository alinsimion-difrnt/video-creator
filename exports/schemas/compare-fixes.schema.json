{
  "$defs": {
    "Annotator": {
      "enum": [
        "code",
        "claude-code",
        "human"
      ],
      "title": "Annotator",
      "type": "string"
    },
    "Fix": {
      "additionalProperties": false,
      "properties": {
        "change": {
          "title": "Change",
          "type": "string"
        },
        "effort": {
          "enum": [
            "S",
            "M",
            "L"
          ],
          "title": "Effort",
          "type": "string"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "problem": {
          "title": "Problem",
          "type": "string"
        },
        "refs": {
          "items": {
            "type": "string"
          },
          "title": "Refs",
          "type": "array"
        },
        "severity": {
          "minimum": 0,
          "title": "Severity",
          "type": "number"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "timestamps_s": {
          "items": {
            "type": "number"
          },
          "title": "Timestamps S",
          "type": "array"
        }
      },
      "required": [
        "metric",
        "problem",
        "evidence",
        "target",
        "change",
        "effort",
        "severity"
      ],
      "title": "Fix",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Carried by every output JSON (BUILD_PLAN section 2.7).",
      "properties": {
        "annotator": {
          "$ref": "#/$defs/Annotator"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "input_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "skill": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9-]+@[0-9a-f]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skill"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "tool_version": {
          "title": "Tool Version",
          "type": "string"
        }
      },
      "required": [
        "tool_version",
        "stage",
        "annotator",
        "input_hash",
        "created_at"
      ],
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "`reports/compare/<id>/fixes.json` (A4 compare-fixes): Claude's top fixes from the corpus metrics.",
  "properties": {
    "fixes": {
      "items": {
        "$ref": "#/$defs/Fix"
      },
      "maxItems": 10,
      "minItems": 1,
      "title": "Fixes",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "video": {
      "title": "Video",
      "type": "string"
    }
  },
  "required": [
    "provenance",
    "video",
    "fixes"
  ],
  "title": "FixesFile",
  "type": "object"
}
