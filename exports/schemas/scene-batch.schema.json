{
  "$defs": {
    "Annotator": {
      "enum": [
        "code",
        "claude-code",
        "human"
      ],
      "title": "Annotator",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Carried by every output JSON (BUILD_PLAN section 2.7).",
      "properties": {
        "annotator": {
          "$ref": "#/$defs/Annotator"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "input_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "skill": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9-]+@[0-9a-f]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skill"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "tool_version": {
          "title": "Tool Version",
          "type": "string"
        }
      },
      "required": [
        "tool_version",
        "stage",
        "annotator",
        "input_hash",
        "created_at"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "SceneAssignment": {
      "additionalProperties": false,
      "properties": {
        "archetype": {
          "title": "Archetype",
          "type": "string"
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "proposed_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proposed Name"
        },
        "shot": {
          "pattern": "^s\\d{3,}$",
          "title": "Shot",
          "type": "string"
        },
        "video": {
          "title": "Video",
          "type": "string"
        }
      },
      "required": [
        "video",
        "shot",
        "archetype",
        "confidence"
      ],
      "title": "SceneAssignment",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "batch": {
      "pattern": "^b\\d{2,}$",
      "title": "Batch",
      "type": "string"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/SceneAssignment"
      },
      "title": "Items",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    }
  },
  "required": [
    "provenance",
    "batch",
    "items"
  ],
  "title": "SceneBatch",
  "type": "object"
}
