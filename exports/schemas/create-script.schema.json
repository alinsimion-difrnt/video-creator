{
  "$defs": {
    "Annotator": {
      "enum": [
        "code",
        "claude-code",
        "human"
      ],
      "title": "Annotator",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Carried by every output JSON (BUILD_PLAN section 2.7).",
      "properties": {
        "annotator": {
          "$ref": "#/$defs/Annotator"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "input_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "skill": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9-]+@[0-9a-f]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skill"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "tool_version": {
          "title": "Tool Version",
          "type": "string"
        }
      },
      "required": [
        "tool_version",
        "stage",
        "annotator",
        "input_hash",
        "created_at"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "ScriptScene": {
      "additionalProperties": false,
      "properties": {
        "beat": {
          "title": "Beat",
          "type": "string"
        },
        "facts": {
          "items": {
            "type": "string"
          },
          "title": "Facts",
          "type": "array"
        },
        "id": {
          "pattern": "^s\\d{2}$",
          "title": "Id",
          "type": "string"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "on_screen": {
          "items": {
            "type": "string"
          },
          "title": "On Screen",
          "type": "array"
        },
        "spoken": {
          "minLength": 1,
          "title": "Spoken",
          "type": "string"
        }
      },
      "required": [
        "id",
        "beat",
        "spoken"
      ],
      "title": "ScriptScene",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "C2: one spoken line (or short paragraph) per scene, in order.",
  "properties": {
    "project": {
      "title": "Project",
      "type": "string"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "scenes": {
      "items": {
        "$ref": "#/$defs/ScriptScene"
      },
      "minItems": 1,
      "title": "Scenes",
      "type": "array"
    }
  },
  "required": [
    "provenance",
    "project",
    "scenes"
  ],
  "title": "Script",
  "type": "object"
}
