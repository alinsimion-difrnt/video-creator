{
  "$defs": {
    "Annotator": {
      "enum": [
        "code",
        "claude-code",
        "human"
      ],
      "title": "Annotator",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Carried by every output JSON (BUILD_PLAN section 2.7).",
      "properties": {
        "annotator": {
          "$ref": "#/$defs/Annotator"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "input_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "skill": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9-]+@[0-9a-f]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skill"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "tool_version": {
          "title": "Tool Version",
          "type": "string"
        }
      },
      "required": [
        "tool_version",
        "stage",
        "annotator",
        "input_hash",
        "created_at"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "SpringCluster": {
      "additionalProperties": false,
      "properties": {
        "n": {
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "remotion": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Remotion",
          "type": "object"
        },
        "settle_ms": {
          "$ref": "#/$defs/Stat"
        },
        "zeta": {
          "$ref": "#/$defs/Stat"
        }
      },
      "required": [
        "n",
        "zeta",
        "settle_ms",
        "remotion"
      ],
      "title": "SpringCluster",
      "type": "object"
    },
    "Stat": {
      "additionalProperties": false,
      "properties": {
        "ci": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ci"
        },
        "median": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Median"
        },
        "n": {
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "p25": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "P25"
        },
        "p75": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "P75"
        },
        "videos": {
          "minimum": 0,
          "title": "Videos",
          "type": "integer"
        },
        "weight": {
          "minimum": 0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "n",
        "videos",
        "weight",
        "median",
        "p25",
        "p75",
        "ci"
      ],
      "title": "Stat",
      "type": "object"
    },
    "Weighting": {
      "additionalProperties": false,
      "properties": {
        "quality": {
          "title": "Quality",
          "type": "boolean"
        },
        "score_from": {
          "title": "Score From",
          "type": "string"
        },
        "score_missing": {
          "title": "Score Missing",
          "type": "number"
        },
        "tier": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Tier",
          "type": "object"
        }
      },
      "required": [
        "tier",
        "score_from",
        "score_missing",
        "quality"
      ],
      "title": "Weighting",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "bezier_by_class": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Bezier By Class",
      "type": "object"
    },
    "duration_ms_by_change": {
      "additionalProperties": {
        "$ref": "#/$defs/Stat"
      },
      "title": "Duration Ms By Change",
      "type": "object"
    },
    "duration_ms_by_role": {
      "additionalProperties": {
        "$ref": "#/$defs/Stat"
      },
      "title": "Duration Ms By Role",
      "type": "object"
    },
    "ease_by_class": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Ease By Class",
      "type": "object"
    },
    "ease_mix": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Ease Mix",
      "type": "object"
    },
    "easing_by_role": {
      "additionalProperties": {
        "additionalProperties": {
          "type": "number"
        },
        "type": "object"
      },
      "title": "Easing By Role",
      "type": "object"
    },
    "easing_mix": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Easing Mix",
      "type": "object"
    },
    "elements": {
      "title": "Elements",
      "type": "integer"
    },
    "overshoot_pct": {
      "$ref": "#/$defs/Stat"
    },
    "overshoot_share": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Overshoot Share"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "springs": {
      "items": {
        "$ref": "#/$defs/SpringCluster"
      },
      "title": "Springs",
      "type": "array"
    },
    "stagger_ms_by_unit": {
      "additionalProperties": {
        "$ref": "#/$defs/Stat"
      },
      "title": "Stagger Ms By Unit",
      "type": "object"
    },
    "videos": {
      "title": "Videos",
      "type": "integer"
    },
    "weighting": {
      "$ref": "#/$defs/Weighting"
    }
  },
  "required": [
    "provenance",
    "weighting",
    "videos",
    "elements",
    "duration_ms_by_role",
    "duration_ms_by_change",
    "easing_mix",
    "easing_by_role",
    "ease_mix",
    "overshoot_share",
    "overshoot_pct",
    "springs",
    "stagger_ms_by_unit"
  ],
  "title": "MotionStats",
  "type": "object"
}
