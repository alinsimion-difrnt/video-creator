{
  "$defs": {
    "Annotator": {
      "enum": [
        "code",
        "claude-code",
        "human"
      ],
      "title": "Annotator",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Carried by every output JSON (BUILD_PLAN section 2.7).",
      "properties": {
        "annotator": {
          "$ref": "#/$defs/Annotator"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "input_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "skill": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9-]+@[0-9a-f]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skill"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "tool_version": {
          "title": "Tool Version",
          "type": "string"
        }
      },
      "required": [
        "tool_version",
        "stage",
        "annotator",
        "input_hash",
        "created_at"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Range": {
      "additionalProperties": false,
      "description": "A measured value for building: the weighted median and the typical (25-75%) range.",
      "properties": {
        "high": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "High"
        },
        "low": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Low"
        },
        "median": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Median"
        },
        "n": {
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "videos": {
          "minimum": 0,
          "title": "Videos",
          "type": "integer"
        }
      },
      "required": [
        "median",
        "low",
        "high",
        "n",
        "videos"
      ],
      "title": "Range",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "articulation_wpm": {
      "$ref": "#/$defs/Range"
    },
    "brief": {
      "items": {
        "type": "string"
      },
      "title": "Brief",
      "type": "array"
    },
    "energy_std_db": {
      "$ref": "#/$defs/Range"
    },
    "pause_length_mix": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Pause Length Mix",
      "type": "object"
    },
    "pause_mean_ms": {
      "$ref": "#/$defs/Range"
    },
    "pause_p90_ms": {
      "$ref": "#/$defs/Range"
    },
    "phrase_rate_cv": {
      "$ref": "#/$defs/Range"
    },
    "pitch_std_semitones": {
      "$ref": "#/$defs/Range"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "wpm": {
      "$ref": "#/$defs/Range"
    }
  },
  "required": [
    "provenance",
    "wpm",
    "articulation_wpm",
    "pause_mean_ms",
    "pause_p90_ms",
    "pause_length_mix",
    "pitch_std_semitones",
    "energy_std_db",
    "phrase_rate_cv",
    "brief"
  ],
  "title": "VoiceSpec",
  "type": "object"
}
