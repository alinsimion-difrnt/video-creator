{
  "$defs": {
    "Annotator": {
      "enum": [
        "code",
        "claude-code",
        "human"
      ],
      "title": "Annotator",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Carried by every output JSON (BUILD_PLAN section 2.7).",
      "properties": {
        "annotator": {
          "$ref": "#/$defs/Annotator"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "input_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Hash",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "schema_version": {
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "skill": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9-]+@[0-9a-f]{8,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skill"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "tool_version": {
          "title": "Tool Version",
          "type": "string"
        }
      },
      "required": [
        "tool_version",
        "stage",
        "annotator",
        "input_hash",
        "created_at"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "Stat": {
      "additionalProperties": false,
      "properties": {
        "ci": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ci"
        },
        "median": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Median"
        },
        "n": {
          "minimum": 0,
          "title": "N",
          "type": "integer"
        },
        "p25": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "P25"
        },
        "p75": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "P75"
        },
        "videos": {
          "minimum": 0,
          "title": "Videos",
          "type": "integer"
        },
        "weight": {
          "minimum": 0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "n",
        "videos",
        "weight",
        "median",
        "p25",
        "p75",
        "ci"
      ],
      "title": "Stat",
      "type": "object"
    },
    "Weighting": {
      "additionalProperties": false,
      "properties": {
        "quality": {
          "title": "Quality",
          "type": "boolean"
        },
        "score_from": {
          "title": "Score From",
          "type": "string"
        },
        "score_missing": {
          "title": "Score Missing",
          "type": "number"
        },
        "tier": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Tier",
          "type": "object"
        }
      },
      "required": [
        "tier",
        "score_from",
        "score_missing",
        "quality"
      ],
      "title": "Weighting",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "articulation_wpm": {
      "anyOf": [
        {
          "$ref": "#/$defs/Stat"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "caption_words_per_group": {
      "$ref": "#/$defs/Stat"
    },
    "cuts_on_beat_share": {
      "$ref": "#/$defs/Stat"
    },
    "duration_s_by_format": {
      "additionalProperties": {
        "$ref": "#/$defs/Stat"
      },
      "title": "Duration S By Format",
      "type": "object"
    },
    "energy_std_db": {
      "anyOf": [
        {
          "$ref": "#/$defs/Stat"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "pace_cv": {
      "$ref": "#/$defs/Stat"
    },
    "pause_length_mix": {
      "additionalProperties": {
        "type": "number"
      },
      "title": "Pause Length Mix",
      "type": "object"
    },
    "pause_mean_ms": {
      "$ref": "#/$defs/Stat"
    },
    "pause_p90_ms": {
      "anyOf": [
        {
          "$ref": "#/$defs/Stat"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "phrase_rate_cv": {
      "anyOf": [
        {
          "$ref": "#/$defs/Stat"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "pitch_std_semitones": {
      "$ref": "#/$defs/Stat"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "shot_s": {
      "$ref": "#/$defs/Stat"
    },
    "shot_s_by_format": {
      "additionalProperties": {
        "$ref": "#/$defs/Stat"
      },
      "title": "Shot S By Format",
      "type": "object"
    },
    "time_to_first_ui_s": {
      "$ref": "#/$defs/Stat"
    },
    "videos": {
      "title": "Videos",
      "type": "integer"
    },
    "weighting": {
      "$ref": "#/$defs/Weighting"
    },
    "wpm": {
      "$ref": "#/$defs/Stat"
    }
  },
  "required": [
    "provenance",
    "weighting",
    "videos",
    "shot_s_by_format",
    "shot_s",
    "pace_cv",
    "cuts_on_beat_share",
    "time_to_first_ui_s",
    "wpm",
    "pitch_std_semitones",
    "pause_mean_ms",
    "caption_words_per_group",
    "duration_s_by_format"
  ],
  "title": "PacingStats",
  "type": "object"
}
